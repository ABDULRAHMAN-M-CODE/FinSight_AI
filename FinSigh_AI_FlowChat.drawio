          </mxGeometry>
        </mxCell>
        <mxCell id="F48MXMclki3weuNWD_pI-2" value="&lt;font color=&quot;#66ff66&quot;&gt;&lt;span style=&quot;font-size: 80px;&quot;&gt;Visual Summery&amp;nbsp;&lt;/span&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="2450" y="-285" width="800" height="240" as="geometry" />
