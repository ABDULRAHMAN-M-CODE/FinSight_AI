eight: inherit; font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: inherit; text-decoration: none; cursor: inherit; border-radius: 2px; background-color: rgb(56, 56, 56); color: rgb(124, 196, 248);&quot;&gt;portfolio_value&lt;/code&gt;: Total portfolio value on that date&lt;/li&gt;&lt;li class=&quot;xq1n1xh x1e56ztr xzboxd6 x4z9k3i xdod15v x22v61l x1tij9ou&quot; style=&quot;margin: 0px 0px 8px 16px; padding: 0px; border: 0px; font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; font-size: 13px; line-height: 21px; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: -0.032px; text-decoration: none; cursor: inherit;&quot;&gt;&lt;code class=&quot;x1v8gsql xtczco7 x4p5aij x1j85h84 xf00w7v x1d60ukw x15klxpg x1hjwid2 x192jxwq&quot; style=&quot;margin: 0px; padding: 1px 0.25rem; border: 0px; font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; font-size: 12.22px; line-height: inherit; font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: inherit; text-decoration: none; cursor: inherit; border-radius: 2px; background-color: rgb(56, 56, 56); color: rgb(124, 196, 248);&quot;&gt;return_percentage&lt;/code&gt;: Percentage change from previous year&lt;/li&gt;&lt;li class=&quot;xq1n1xh x1e56ztr xzboxd6 x4z9k3i xdod15v x22v61l x1tij9ou&quot; style=&quot;margin: 0px 0px 0px 16px; padding: 0px; border: 0px; font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; font-size: 13px; line-height: 21px; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: -0.032px; text-decoration: none; cursor: inherit;&quot;&gt;&lt;code class=&quot;x1v8gsql xtczco7 x4p5aij x1j85h84 xf00w7v x1d60ukw x15klxpg x1hjwid2 x192jxwq&quot; style=&quot;margin: 0px; padding: 1px 0.25rem; border: 0px; font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; font-size: 12.22px; line-height: inherit; font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: inherit; text-decoration: none; cursor: inherit; border-radius: 2px; background-color: rgb(56, 56, 56); color: rgb(124, 196, 248);&quot;&gt;risk_level&lt;/code&gt;: Overall portfolio risk level at that point in time&lt;/li&gt;&lt;/ul&gt;&lt;p class=&quot;xvwc6ox x4z9k3i x1j61x8r x15m7nig xdod15v x22v61l x4vex6e xzboxd6&quot; style=&quot;margin: 0px 0px 16px; padding: 0px; border: 0px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-variant-numeric: inherit; font-variant-east-asian: inherit; font-variant-alternates: inherit; font-variant-position: inherit; font-variant-emoji: inherit; font-weight: 450; font-stretch: inherit; font-size: 13px; line-height: 21px; font-family: Inter; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: -0.032px; text-decoration: none; cursor: inherit; color: rgb(255, 255, 255); orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(44, 44, 44);&quot;&gt;&lt;strong class=&quot;x19s9jnd&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: inherit; font-variant: inherit; font-weight: 650; font-stretch: inherit; font-size: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: inherit; text-decoration: none; cursor: inherit;&quot;&gt;BACKEND CALCULATION FORMULAS:&lt;/strong&gt;&lt;/p&gt;&lt;pre class=&quot;x1v8gsql x4p5aij x1j85h84 xf00w7v x1d60ukw x15klxpg x1hjwid2 x192jxwq x126k92a x1mzt3pk x4vex6e xzboxd6&quot; style=&quot;margin: 0px 0px 16px; padding: 1px 0.25rem; border: 0px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-variant-numeric: inherit; font-variant-east-asian: inherit; font-variant-alternates: inherit; font-variant-position: inherit; font-variant-emoji: inherit; font-weight: 450; font-stretch: inherit; font-size: 12.22px; line-height: inherit; font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: 0.065px; text-decoration: none; cursor: inherit; border-radius: 2px; background-color: rgb(56, 56, 56); overflow-wrap: break-word; white-space: pre-wrap; color: rgb(255, 255, 255); orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px;&quot;&gt;&lt;code class=&quot;x1v8gsql xtczco7 x4p5aij x1j85h84 xf00w7v x1d60ukw x15klxpg x1hjwid2 x192jxwq&quot; style=&quot;margin: 0px; padding: 1px 0.25rem; border: 0px; font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; font-size: 11.4868px; line-height: inherit; font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: inherit; text-decoration: none; cursor: inherit; border-radius: 2px; background-color: rgb(56, 56, 56); color: rgb(124, 196, 248);&quot;&gt;🖥️ Executed by scheduled backend job (runs annually on January 1st at 2:00 AM):&#xa;&#xa;snapshot_year = YEAR(CURRENT_DATE) - 1&#xa;  Example: Running on Jan 1, 2025 → snapshot_year = 2024&#xa;&#xa;snapshot_date = DATE(snapshot_year, 12, 31)&#xa;  Example: 2024-12-31 (last day of the year)&#xa;&#xa;portfolio_value = SUM(current_value) &#xa;  FROM investment_accounts &#xa;  WHERE user_id = ? AND is_active = true&#xa;&#xa;previous_year_snapshot = SELECT portfolio_value &#xa;  FROM investment_performance_snapshots&#xa;  WHERE user_id = ? AND snapshot_year = (snapshot_year - 1)&#xa;  LIMIT 1&#xa;&#xa;IF previous_year_snapshot EXISTS:&#xa;  return_percentage = &#xa;    ((portfolio_value - previous_year_snapshot.portfolio_value) &#xa;     / previous_year_snapshot.portfolio_value) × 100&#xa;ELSE:&#xa;  return_percentage = 0  -- First year, no comparison&#xa;&#xa;risk_level = weighted_average_risk(investment_accounts)&#xa;  &#xa;  Algorithm:&#xa;    total_value = portfolio_value&#xa;    weighted_score = 0&#xa;    &#xa;    FOR EACH account IN investment_accounts WHERE is_active = true:&#xa;      weight = account.current_value / total_value&#xa;      risk_score = risk_to_number(account.risk_level)&#xa;        where: low = 1, medium = 2, high = 3&#xa;      weighted_score += (risk_score × weight)&#xa;    &#xa;    Map weighted_score back to risk_level:&#xa;      IF weighted_score &amp;lt; 1.5 THEN &quot;low&quot;&#xa;      ELSE IF weighted_score &amp;lt; 2.5 THEN &quot;medium&quot;&#xa;      ELSE &quot;high&quot;&#xa;&lt;/code&gt;&lt;/pre&gt;&lt;p class=&quot;xvwc6ox x4z9k3i x1j61x8r x15m7nig xdod15v x22v61l x4vex6e xzboxd6&quot; style=&quot;margin: 0px 0px 16px; padding: 0px; border: 0px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-variant-numeric: inherit; font-variant-east-asian: inherit; font-variant-alternates: inherit; font-variant-position: inherit; font-variant-emoji: inherit; font-weight: 450; font-stretch: inherit; font-size: 13px; line-height: 21px; font-family: Inter; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: -0.032px; text-decoration: none; cursor: inherit; color: rgb(255, 255, 255); orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(44, 44, 44);&quot;&gt;&lt;strong class=&quot;x19s9jnd&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: inherit; font-variant: inherit; font-weight: 650; font-stretch: inherit; font-size: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: inherit; text-decoration: none; cursor: inherit;&quot;&gt;WHY STORED (CRITICAL - cannot calculate at runtime):&lt;/strong&gt;&lt;/p&gt;&lt;p class=&quot;xvwc6ox x4z9k3i x1j61x8r x15m7nig xdod15v x22v61l x4vex6e xzboxd6&quot; style=&quot;margin: 0px 0px 16px; padding: 0px; border: 0px; font-style: normal; font-variant-ligatures: normal; font-va