e-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: -0.032px; text-decoration: none; cursor: inherit;&quot;&gt;Return % compares this year vs previous year&lt;/li&gt;&lt;li class=&quot;xq1n1xh x1e56ztr xzboxd6 x4z9k3i xdod15v x22v61l x1tij9ou&quot; style=&quot;margin: 0px 0px 8px 16px; padding: 0px; border: 0px; font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; font-size: 13px; line-height: 21px; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: -0.032px; text-decoration: none; cursor: inherit;&quot;&gt;Without snapshots, year-over-year returns are impossible to compute&lt;/li&gt;&lt;li class=&quot;xq1n1xh x1e56ztr xzboxd6 x4z9k3i xdod15v x22v61l x1tij9ou&quot; style=&quot;margin: 0px 0px 0px 16px; padding: 0px; border: 0px; font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; font-size: 13px; line-height: 21px; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: -0.032px; text-decoration: none; cursor: inherit;&quot;&gt;Example: 2024 return of +40.9% means portfolio grew from $98,200 (2023) to $138,400 (2024)&lt;/li&gt;&lt;/ul&gt;&lt;p class=&quot;xvwc6ox x4z9k3i x1j61x8r x15m7nig xdod15v x22v61l x4vex6e xzboxd6&quot; style=&quot;margin: 0px 0px 16px; padding: 0px; border: 0px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-variant-numeric: inherit; font-variant-east-asian: inherit; font-variant-alternates: inherit; font-variant-position: inherit; font-variant-emoji: inherit; font-weight: 450; font-stretch: inherit; font-size: 13px; line-height: 21px; font-family: Inter; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: -0.032px; text-decoration: none; cursor: inherit; color: rgb(255, 255, 255); orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(44, 44, 44);&quot;&gt;❗&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;strong class=&quot;x19s9jnd&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: inherit; font-variant: inherit; font-weight: 650; font-stretch: inherit; font-size: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: inherit; text-decoration: none; cursor: inherit;&quot;&gt;Total Returns Stat Card&lt;/strong&gt;&lt;/p&gt;&lt;ul class=&quot;x1717udv x1ghz6dp x43c9pm xtaz4m5 x4vex6e xzboxd6&quot; style=&quot;margin: 0px 0px 16px; padding: 0px; border: 0px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-variant-numeric: inherit; font-variant-east-asian: inherit; font-variant-alternates: inherit; font-variant-position: inherit; font-variant-emoji: inherit; font-weight: 450; font-stretch: inherit; font-size: 13px; line-height: inherit; font-family: Inter, sans-serif, SFProLocalRange; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: 0.065px; text-decoration: none; cursor: inherit; list-style: outside disc; color: rgb(255, 255, 255); orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(44, 44, 44);&quot;&gt;&lt;li class=&quot;xq1n1xh x1e56ztr xzboxd6 x4z9k3i xdod15v x22v61l x1tij9ou&quot; style=&quot;margin: 0px 0px 8px 16px; padding: 0px; border: 0px; font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; font-size: 13px; line-height: 21px; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: -0.032px; text-decoration: none; cursor: inherit;&quot;&gt;Total Returns = Current Value - Initial Investment Value&lt;/li&gt;&lt;li class=&quot;xq1n1xh x1e56ztr xzboxd6 x4z9k3i xdod15v x22v61l x1tij9ou&quot; style=&quot;margin: 0px 0px 8px 16px; padding: 0px; border: 0px; font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; font-size: 13px; line-height: 21px; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: -0.032px; text-decoration: none; cursor: inherit;&quot;&gt;Initial value comes from earliest snapshot (e.g., 2021: $82,000)&lt;/li&gt;&lt;li class=&quot;xq1n1xh x1e56ztr xzboxd6 x4z9k3i xdod15v x22v61l x1tij9ou&quot; style=&quot;margin: 0px 0px 0px 16px; padding: 0px; border: 0px; font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; font-size: 13px; line-height: 21px; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: -0.032px; text-decoration: none; cursor: inherit;&quot;&gt;Example: $138,400 (current) - $82,000 (2021) = $56,400 total returns&lt;/li&gt;&lt;/ul&gt;&lt;p class=&quot;xv