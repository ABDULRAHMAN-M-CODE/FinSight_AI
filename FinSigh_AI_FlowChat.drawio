-height: 21px; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: -0.032px; text-decoration: none; cursor: inherit;&quot;&gt;Cannot create foreign key relationships for snapshots table&lt;/li&gt;&lt;li class=&quot;xq1n1xh x1e56ztr xzboxd6 x4z9k3i xdod15v x22v61l x1tij9ou&quot; style=&quot;margin: 0px 0px 8px 16px; padding: 0px; border: 0px; font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; font-size: 13px; line-height: 21px; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: -0.032px; text-decoration: none; cursor: inherit;&quot;&gt;Poor queryability for aggregations and filtering&lt;/li&gt;&lt;li class=&quot;xq1n1xh x1e56ztr xzboxd6 x4z9k3i xdod15v x22v61l x1tij9ou&quot; style=&quot;margin: 0px 0px 0px 16px; padding: 0px; border: 0px; font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; font-size: 13px; line-height: 21px; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: -0.032px; text-decoration: none; cursor: inherit;&quot;&gt;Difficult to track individual account changes over time&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p class=&quot;xvwc6ox x4z9k3i x1j61x8r x15m7nig xdod15v x22v61l x4vex6e xzboxd6&quot; style=&quot;margin: 0px 0px 16px; padding: 0px; border: 0px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-variant-numeric: inherit; font-variant-east-asian: inherit; font-variant-alternates: inherit; font-variant-position: inherit; font-variant-emoji: inherit; font-weight: 450; font-stretch: inherit; font-size: 13px; line-height: 21px; font-family: Inter; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: -0.032px; text-decoration: none; cursor: inherit; color: rgb(255, 255, 255); orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(44, 44, 44);&quot;&gt;&lt;strong class=&quot;x19s9jnd&quot; style=&quot;margin: 0px; padding: 0px; border: 0px; font-style: inherit; font-variant: inherit; font-weight: 650; font-stretch: inherit; font-size: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: inherit; text-decoration: none; cursor: inherit;&quot;&gt;EXAMPLE DATA:&lt;/strong&gt;&lt;/p&gt;&lt;pre class=&quot;x1v8gsql x4p5aij x1j85h84 xf00w7v x1d60ukw x15klxpg x1hjwid2 x192jxwq x126k92a x1mzt3pk x4vex6e xzboxd6&quot; style=&quot;margin: 0px 0px 16px; padding: 1px 0.25rem; border: 0px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-variant-numeric: inherit; font-variant-east-asian: inherit; font-variant-alternates: inherit; font-variant-position: inherit; font-variant-emoji: inherit; font-weight: 450; font-stretch: inherit; font-size: 12.22px; line-height: inherit; font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: 0.065px; text-decoration: none; cursor: