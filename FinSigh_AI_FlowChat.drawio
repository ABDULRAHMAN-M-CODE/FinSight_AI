ght: inherit; font-stretch: inherit; font-size: 13px; line-height: 21px; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: -0.032px; text-decoration: none; cursor: inherit;&quot;&gt;Total Returns = Current Value - Initial Investment Value&lt;/li&gt;&lt;li class=&quot;xq1n1xh x1e56ztr xzboxd6 x4z9k3i xdod15v x22v61l x1tij9ou&quot; style=&quot;margin: 0px 0px 8px 16px; padding: 0px; border: 0px; font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; font-size: 13px; line-height: 21px; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: -0.032px; text-decoration: none; cursor: inherit;&quot;&gt;Initial value comes from earliest snapshot (e.g., 2021: $82,000)&lt;/li&gt;&lt;li class=&quot;xq1n1xh x1e56ztr xzboxd6 x4z9k3i xdod15v x22v61l x1tij9ou&quot; style=&quot;margin: 0px 0px 0px 16px; padding: 0px; border: 0px; font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; font-size: 13px; line-height: 21px; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: -0.032px; text-decoration: none; cursor: inherit;&quot;&gt;Example: $138,400 (current) - $82,000 (2021) = $56,400 total returns&lt;/li&gt;&lt;/ul&gt;&lt;p class=&quot;xvwc6ox x4z9k3i x1j61x8r x15m7nig xdod15v x22v61l x4vex6e xzboxd6&quot; style=&quot;margin: 0px 0px 16px; padding: 0px; border: 0px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-variant-numeric: inherit; font-variant-east-asian: inherit; font-