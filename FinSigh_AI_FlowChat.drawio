                <mxCell id="YVw5xbykK3pbnoSdpkQw-10" value="&lt;font style=&quot;color: rgb(255, 51, 51); font-size: 80px;&quot;&gt;Example of&amp;nbsp; Why we should Separate the tables!&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-3180" y="-480" width="2390" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="YVw5xbykK3pbnoSdpkQw-17" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
                    <mxGeometry x="-1890" y="-280" width="494.86" height="500" as="geometry"/>
                </mxCell>
                <mxCell id="YVw5xbykK3pbnoSdpkQw-18" value="&lt;font&gt;&lt;span style=&quot;font-size: 80px;&quot;&gt;&lt;font color=&quot;#66ff66&quot;&gt;The followign are the tables that will be stored in the DataBase , those Tables contain Data &lt;/font&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;Relevant to the first UI&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="-570" y="-410" width="2390" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="YVw5xbykK3pbnoSdpkQw-19" value="&lt;pre class=&quot;x1v8gsql x4p5aij x1j85h84 xf00w7v x1d60ukw x15klxpg x1hjwid2 x192jxwq x126k92a x1mzt3pk x4vex6e xzboxd6&quot; style=&quot;margin: 0px 0px 16px; padding: 1px 0.25rem; border: 0px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-variant-numeric: inherit; font-variant-east-asian: inherit; font-variant-alternates: inherit; font-variant-position: inherit; font-variant-emoji: inherit; font-weight: 450; font-stretch: inherit; font-size: 12.22px; line-height: inherit; font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: 0.065px; text-decoration: none; cursor: inherit; border-radius: 2px; background-color: rgb(56, 56, 56); overflow-wrap: break-word; white-space: pre-wrap; color: rgb(255, 255, 255); orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px;&quot;&gt;&lt;code class=&quot;x1v8gsql xtczco7 x4p5aij x1j85h84 xf00w7v x1d60ukw x15klxpg x1hjwid2 x192jxwq&quot; style=&quot;margin: 0px; padding: 1px 0.25rem; border: 0px; font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; font-size: 11.4868px; line-height: inherit; font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: inherit; text-decoration: none; cursor: inherit; border-radius: 2px; background-color: rgb(56, 56, 56); color: rgb(124, 196, 248);&quot;&gt;┌─────────────────────────────────────────────────────────────────────────┐&#xa;│ TABLE: health_score_snapshots                                            │&#xa;├───────────────────┬──────────────┬──────────────────────────────────────┤&#xa;│ FIELD             │ TYPE         │ SOURCE                               │&#xa;├───────────────────┼──────────────┼──────────────────────────────────────┤&#xa;│ id                │ UUID         │ AUTO-GENERATED (database)            │&#xa;│ user_id           │ UUID         │ FOREIGN KEY → users                  │&#xa;│ overall_score     │ INTEGER      │ 🖥️ BACKEND COMPUTED (formula)        │&#xa;│ calculated_at     │ TIMESTAMP    │ AUTO-GENERATED (database)            │&#xa;└───────────────────┴──────────────┴──────────────────────────────────────┘&#xa;&#xa;BACKEND CALCULATION FORMULA:&#xa;overall_score = weighted average of:&#xa;  - Cash Flow Score (33%): based on savings_rate from existing data&#xa;  - Debt Score (33%): based on outstanding_debts debt-to-income ratio&#xa;  - Goals Score (33%): average progress across all goals&#xa;  &#xa;USES EXISTING DATA:&#xa;  - monthly_income, monthly_expenses, savings_rate&#xa;  - outstanding_debts (balance, monthly_payment, interest_rate)&#xa;  - goals (current_amount, target_amount, deadline)&lt;/code&gt;&lt;/pre&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="-300" y="520" width="530" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="YVw5xbykK3pbnoSdpkQw-20" value="&lt;pre class=&quot;x1v8gsql x4p5aij x1j85h84 xf00w7v x1d60ukw x15klxpg x1hjwid2 x192jxwq x126k92a x1mzt3pk x4vex6e xzboxd6&quot; style=&quot;margin: 0px 0px 16px; padding: 1px 0.25rem; border: 0px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-variant-numeric: inherit; font-variant-east-asian: inherit; font-variant-alternates: inherit; font-variant-position: inherit; font-variant-emoji: inherit; font-weight: 450; font-stretch: inherit; font-size: 12.22px; line-height: inherit; font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: 0.065px; text-decoration: none; cursor: inherit; border-radius: 2px; background-color: rgb(56, 56, 56); overflow-wrap: break-word; white-space: pre-wrap; color: rgb(255, 255, 255); orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px;&quot;&gt;&lt;code class=&quot;x1v8gsql xtczco7 x4p5aij x1j85h84 xf00w7v x1d60ukw x15klxpg x1hjwid2 x192jxwq&quot; style=&quot;margin: 0px; padding: 1px 0.25rem; border: 0px; font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; font-size: 11.4868px; line-height: inherit; font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: inherit; text-decoration: none; cursor: inherit; border-radius: 2px; background-color: rgb(56, 56, 56); color: rgb(124, 196, 248);&quot;&gt;┌─────────────────────────────────────────────────────────────────────────┐&#xa;│ TABLE: ai_reassurance_messages                                           │&#xa;├───────────────────┬──────────────┬──────────────────────────────────────┤&#xa;│ FIELD             │ TYPE         │ SOURCE                               │&#xa;├───────────────────┼──────────────┼──────────────────────────────────────┤&#xa;│ id                │ UUID         │ AUTO-GENERATED (database)            │&#xa;│ user_id           │ UUID         │ FOREIGN KEY → users                  │&#xa;│ message_text      │ TEXT         │ 🤖 AI COMPUTED (LLM generates)       │&#xa;│ generated_at      │ TIMESTAMP    │ AUTO-GENERATED (database)            │&#xa;└───────────────────┴──────────────┴──────────────────────────────────────┘&#xa;&#xa;NOTES:&#xa;- message_text: Personalized reassurance based on health score&#xa;- AI analyzes overall financial picture and generates encouraging message&#xa;- Example: &quot;You&#39;re making solid progress! Your 18% savings rate is above average...&quot;&lt;/code&gt;&lt;/pre&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="1050" y="560" width="560" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="F48MXMclki3weuNWD_pI-1" value="&lt;pre class=&quot;x1v8gsql x4p5aij x1j85h84 xf00w7v x1d60ukw x15klxpg x1hjwid2 x192jxwq x126k92a x1mzt3pk x4vex6e xzboxd6&quot; style=&quot;margin: 0px 0px 16px; padding: 1px 0.25rem; border: 0px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-variant-numeric: inherit; font-variant-east-asian: inherit; font-variant-alternates: inherit; font-variant-position: inherit; font-variant-emoji: inherit; font-weight: 450; font-stretch: inherit; font-size: 12.22px; line-height: inherit; font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: 0.065px; text-decoration: none; cursor: inherit; border-radius: 2px; background-color: rgb(56, 56, 56); overflow-wrap: break-word; white-space: pre-wrap; color: rgb(255, 255, 255); orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px;&quot;&gt;&lt;code class=&quot;x1v8gsql xtczco7 x4p5aij x1j85h84 xf00w7v x1d60ukw x15klxpg x1hjwid2 x192jxwq&quot; style=&quot;margin: 0px; padding: 1px 0.25rem; border: 0px; font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; font-size: 11.4868px; line-height: inherit; font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; vertical-align: inherit; outline: none; letter-spacing: inherit; text-decoration: none; cursor: inherit; border-radius: 2px; background-color: rgb(56, 56, 56); color: rgb(124, 196, 248);&quot;&gt;1️⃣  goals&#xa;    ├─ goal_name           [👤 USER]&#xa;    ├─ target_amount       [👤 USER]&#xa;    ├─ current_amount      [🖥️ BACKEND]&#xa;    ├─ deadline            [👤 USER]&#xa;    └─ goal_type           [👤 USER]&#xa;&#xa;2️⃣  ai_goal_insights&#xa;    ├─ goal_id             [FK]&#xa;    └─ ai_insight          [🤖 AI]&#xa;&#xa;3️⃣  health_score_snapshots&#xa;    └─ overall_score       [🖥️ BACKEND]&#xa;&#xa;4️⃣  ai_reassurance_messages&#xa;    └─ message_text        [🤖 AI]&lt;/code&gt;&lt;/pre&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="2705" y="165" width="290" height="280" as="geometry"/>
                </mxCell>
