        <mxCell id="Kz5jj_GifknlN1pNBJkx-16" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 50px;&quot;&gt;&lt;font color=&quot;#ff0000&quot;&gt;Additions : subjective (emotional ) questions to determine the behavior of the user in such financial situation (like what the user would do in case of catastropic loss in stocks ? what would he do in case of some financial situations ? how would he react emotionally and&amp;nbsp; what action would he take ? ) using &amp;lt;Select&amp;gt; tag in HTML&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" parent="O5dXnigAVppLvb0me8Yg-6" vertex="1">
          <mxGeometry x="130" width="1400" height="412.3711340206185" as="geometry" />
        </mxCell>
        <mxCell id="Kz5jj_GifknlN1pNBJkx-19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="O5dXnigAVppLvb0me8Yg-6" source="Kz5jj_GifknlN1pNBJkx-17" target="Kz5jj_GifknlN1pNBJkx-7" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Kz5jj_GifknlN1pNBJkx-17" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font color=&quot;#ff0000&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;Removels : We must never ask the user for his investments : the&amp;nbsp; only reason rob advisor exist is to tell the user what investmenets he should select from the market, not to&amp;nbsp; give him&amp;nbsp; a fucking&amp;nbsp; advice ! textual advice can be given , but only after we automate the portflio consturction&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" parent="O5dXnigAVppLvb0me8Yg-6" vertex="1">
          <mxGeometry x="170" y="463.9175257731958" width="1400" height="391.7525773195876" as="geometry" />
        </mxCell>
        <mxCell id="Kz5jj_GifknlN1pNBJkx-21" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;color: rgb(91, 63, 71);&quot;&gt;&lt;span style=&quot;font-size: 50px; background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;We tell the users how money exacly he must put on each asses (example , allocate 50% of your money on bonds, ETF funds, allocate 30% of your money on stocks, etc...)&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" parent="O5dXnigAVppLvb0me8Yg-6" vertex="1">
          <mxGeometry x="-50" y="1960" width="1400" height="260" as="geometry" />
        </mxCell>
        <mxCell id="O5dXnigAVppLvb0me8Yg-28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" parent="O5dXnigAVppLvb0me8Yg-6" source="O5dXnigAVppLvb0me8Yg-20" target="Kz5jj_GifknlN1pNBJkx-21" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="O5dXnigAVppLvb0me8Yg-20" value="&lt;span style=&quot;color: rgb(255, 0, 0); font-size: 50px;&quot;&gt;&amp;nbsp;asect allocation (Modern Portfolio theory algorithim)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="O5dXnigAVppLvb0me8Yg-6" vertex="1">
          <mxGeometry x="1960" y="2220" width="450" height="300" as="geometry" />
        </mxCell>
        <mxCell id="O5dXnigAVppLvb0me8Yg-22" value="&lt;span style=&quot;color: rgb(255, 0, 0); font-size: 50px;&quot;&gt;Construct the portfolio&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="O5dXnigAVppLvb0me8Yg-6" vertex="1">
          <mxGeometry x="1945" y="1670" width="470" height="90" as="geometry" />
        </mxCell>
        <mxCell id="O5dXnigAVppLvb0me8Yg-25" value="&lt;span style=&quot;color: rgb(255, 0, 0); font-size: 50px;&quot;&gt;&amp;nbsp;asset selection&amp;nbsp; (algorithim or rule based selection)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="O5dXnigAVppLvb0me8Yg-6" vertex="1">
          <mxGeometry x="1930" y="1810" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="6Rp3LKcvT2yEufIeF3tc-6" value="&lt;font color=&quot;#ff0000&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;After portfolio is already implmented , monitor it ,Portfolio Rebalancing (Explain it&#39;s meaning first)&lt;/span&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="O5dXnigAVppLvb0me8Yg-9" vertex="1">
          <mxGeometry x="2570" y="3229.998969072165" width="789" height="362.8865979381443" as="geometry" />
        </mxCell>
        <mxCell id="6Rp3LKcvT2yEufIeF3tc-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" parent="O5dXnigAVppLvb0me8Yg-9" source="6Rp3LKcvT2yEufIeF3tc-6" target="O5dXnigAVppLvb0me8Yg-29" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2270" y="3071.9587628865975" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="O5dXnigAVppLvb0me8Yg-29" value="&lt;font color=&quot;#ff0000&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;Rebalancing can happen due to three Reasons : 1- The value of investement increase or decrease , 2-glide path ; when the deadline of goal is near the end, adjust (rebalance) the portfolio to be less risky , 3- when the user change his informations like risk tolerance and goals (subjective ) , then risk profile will be changed, that means rebalancing is a must&amp;nbsp;&lt;/span&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="O5dXnigAVppLvb0me8Yg-9" vertex="1">
          <mxGeometry x="580" y="3340" width="1430" height="536.082474226804" as="geometry" />
        </mxCell>
