        <mxCell id="Kz5jj_GifknlN1pNBJkx-7" value="&lt;font color=&quot;#ff0000&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;Minimal additions/ emovals on the questionnary&amp;nbsp;&lt;/span&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="O5dXnigAVppLvb0me8Yg-6" vertex="1">
