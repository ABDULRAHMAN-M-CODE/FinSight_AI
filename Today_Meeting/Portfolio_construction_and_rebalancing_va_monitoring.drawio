        <mxCell id="Kz5jj_GifknlN1pNBJkx-8" value="&lt;font color=&quot;#ff0000&quot;&gt;&lt;span style=&quot;font-size: 50px;&quot;&gt;Determine risk profile (potential off loss means risk, there are many types of risk, here , risk depend on objective and subjective informations)&amp;nbsp;&lt;/span&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="O5dXnigAVppLvb0me8Yg-6" vertex="1">
