        <mxCell id="KCHz7h-SxDL_h4PmOfOz-15" value="&lt;font style=&quot;color: rgb(255, 0, 0); font-size: 50px;&quot;&gt;Search for Idea of financial Advice&amp;nbsp; or service to give to the user based on his inputs only&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
