        <mxCell id="H3DCpCM3TB73iOrC_Rii-2" value="&lt;font color=&quot;#ff3333&quot;&gt;Backend should not trust frontend for security purposes&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#ff3333&quot;&gt;Clean&amp;nbsp; data in both frontend and backend&lt;/font&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=#1A1A1A;" parent="H3DCpCM3TB73iOrC_Rii-3" vertex="1">
