<?xml version="1.0" encoding="UTF-8"?>
<!--
CAUTION: Do not modify this file unless you know what you are doing.
 Unexpected results may occur if the code is changed deliberately.
-->
<dbmodel pgmodeler-ver="1.2.2" use-changelog="false" max-obj-count="4"
	 gen-disabled-objs-code="false" show-sys-schemas-rects="true"
	 last-position="0,154" last-zoom="0.7" scene-rect="0,0,1911.18,1076.8"
	 default-schema="public" default-owner="postgres"
	 layers="Default layer"
	 active-layers="0"
	 layer-name-colors="#000000"
	 layer-rect-colors="#b4b4b4"
	 show-layer-names="false" show-layer-rects="false">
<database name="new_database" is-template="false" allow-conns="true">
</database>

<schema name="public" layers="0" fill-color="#e1e1e1" name-color="#000000" sql-disabled="true">
</schema>

<table name="users" layers="0" collapse-mode="1" max-obj-count="12" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="880" y="280"/>
	<column name="id" not-null="true"
	 identity-type="ALWAYS">
		<type name="bigint" length="0"/>
	</column>
	<column name="email" not-null="true">
		<type name="varchar" length="255"/>
	</column>
	<column name="password_hash" not-null="true">
		<type name="varchar" length="255"/>
		<comment> <![CDATA[computed by backend]]> </comment>
	</column>
	<column name="full_name">
		<type name="varchar" length="255" precision="5"/>
		<comment> <![CDATA[USER PROVIDED (optional) ]]> </comment>
	</column>
	<column name="phone_number">
		<type name="varchar" length="20" precision="5"/>
		<comment> <![CDATA[USER PROVIDED (optional) , I may or may not enforce the user to 
provide his phone number in the frontend]]> </comment>
	</column>
	<column name="email_verified" not-null="true" default-value="FALSE">
		<type name="bool" length="0"/>
		<comment> <![CDATA[Related to Signup
]]> </comment>
	</column>
	<column name="email_verified_at">
		<type name="timestamptz" length="0"/>
		<comment> <![CDATA[BACKEND COMPUTED (on verification)]]> </comment>
	</column>
	<column name="last_login_at">
		<type name="timestamptz" length="0"/>
		<comment> <![CDATA[🖥️ BACKEND COMPUTED (on login)  ]]> </comment>
	</column>
	<column name="created_at" not-null="true" default-value="now()">
		<type name="timestamptz" length="0"/>
	</column>
	<column name="updated_at" not-null="true" default-value="now()">
		<type name="timestamptz" length="0"/>
	</column>
	<constraint name="id" type="pk-constr" table="public.users">
		<columns names="id" ref-type="src-columns"/>
	</constraint>
	<constraint name="disallow_repeated_emails" type="uq-constr" table="public.users">
		<columns names="email" ref-type="src-columns"/>
	</constraint>
</table>

<function name="updated_at_Function"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="VOLATILE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="1"
		row-amount="0">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<type name="trigger" length="0"/>
	</return-type>
	<definition> <![CDATA[BEGIN
  NEW.updated_at = CURRENT_TIMESTAMP;
  RETURN NEW;
END;]]> </definition>
</function>

<trigger name="trigger_update_timestamp" firing-type="BEFORE" per-line="true" constraint="false"
	 ins-event="false" del-event="false" upd-event="true" trunc-event="false"
	 table="public.users">
		<function signature="public.&quot;updated_at_Function&quot;()"/>
</trigger>

<function name="modify_updated_at"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="VOLATILE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="1"
		row-amount="0">
	<schema name="public"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<type name="trigger" length="0"/>
	</return-type>
	<definition> <![CDATA[BEGIN
  NEW.updated_at = CURRENT_TIMESTAMP;
  RETURN NEW;
END;]]> </definition>
</function>

<table name="password_reset_tokens" layers="0" collapse-mode="2" max-obj-count="7" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="1520" y="600"/>
	<column name="id" not-null="true"
	 identity-type="ALWAYS">
		<type name="bigint" length="0"/>
		<comment> <![CDATA[identification colmun , it's sequential , like the following :
token 1 → id 1
token 2 → id 2
token 3 → id 3
etc......]]> </comment>
	</column>
	<column name="token_hash" not-null="true">
		<type name="varchar" length="255"/>
		<comment> <![CDATA[
We store the hash of the token for security purposes, but we send the plain text token to the user , not the hashed token.
Every token must be hashed , thus → NOT NULL ]]> </comment>
	</column>
	<column name="expires_at" not-null="true">
		<type name="timestamptz" length="0"/>
		<comment> <![CDATA[BACKEND COMPUTED]]> </comment>
	</column>
	<column name="used_at">
		<type name="timestamptz" length="0"/>
		<comment> <![CDATA[BACKEND COMPUTED]]> </comment>
	</column>
	<column name="created_at" not-null="true" default-value="now()">
		<type name="timestamptz" length="0"/>
	</column>
	<constraint name="password_reset_tokens_pk" type="pk-constr" table="public.password_reset_tokens">
		<columns names="id" ref-type="src-columns"/>
	</constraint>

	<customidxs object-type="column">
		<object name="id_users" index="5"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="users_fk" index="1"/>
	</customidxs></table>

<relationship name="users_has_many_password_reset_tokens" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 fk-idx-pattern="{st}_idx"
	 custom-color="#78599e"
	 src-table="public.users"
	 dst-table="public.password_reset_tokens"
	 src-required="true" dst-required="false">
	<label ref-type="name-label">
		<position x="117.937" y="-108.514"/>
	</label>
</relationship>

<table name="email_verification_tokens" layers="0" collapse-mode="2" max-obj-count="7" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<comment> <![CDATA[This Table Related to the Signup process ]]> </comment>
	<position x="360" y="600"/>
	<column name="id" not-null="true">
		<type name="bigint" length="0"/>
		<comment> <![CDATA[Identification collumn , it's values are sequnatial ,it's auto generated]]> </comment>
	</column>
	<column name="token_hash" not-null="true">
		<type name="varchar" length="255"/>
		<comment> <![CDATA[BACKEND COMPUTED,hashed for security purposes.
Must have hash →  NOT NULL
hash token only when token is generated → no Default value]]> </comment>
	</column>
	<column name="expires_at" not-null="true">
		<type name="timestamptz" length="0"/>
		<comment> <![CDATA[BACKEND COMPUTED
timestamptz → time zone syncronized
backend must calcuate expiration date → postgres set no Default value
There must be expiration date → NOT NULL IS ENFORCED]]> </comment>
	</column>
	<column name="verified_at">
		<type name="timestamptz" length="0"/>
		<comment> <![CDATA[BACKEND COMPUTED
TIMESTAMPTZ→ TIME ZONE SYNCRONZIED
NOT SET UNTIL USER IS VERIFIED → POSTGRES SET NOT DEFAULT VALUE, CAN BE NULL (NULLABLE)]]> </comment>
	</column>
	<column name="created_at" not-null="true" default-value="now()">
		<type name="timestamptz" length="0"/>
		<comment> <![CDATA[timestamptz                      → TIME ZONE IS SYNCRONIZED
AUTO-GENERATED            → USING NOW() FUNCTION AS DEFAULT VALUE
creation time of email verification token must be tracked → NOT NULL]]> </comment>
	</column>
	<constraint name="email_verification_tokens_pk" type="pk-constr" table="public.email_verification_tokens">
		<columns names="id" ref-type="src-columns"/>
	</constraint>

	<customidxs object-type="column">
		<object name="id_users" index="5"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="users_fk" index="1"/>
	</customidxs></table>

<relationship name="users_has_many_email_verification_tokens" type="rel1n" layers="0"
	 src-col-pattern="{sc}_{st}"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 fk-idx-pattern="{st}_idx"
	 custom-color="#85feb0"
	 src-table="public.users"
	 dst-table="public.email_verification_tokens"
	 src-required="true" dst-required="false">
	<label ref-type="name-label">
		<position x="-171.695" y="-66.4674"/>
	</label>
</relationship>

</dbmodel>
